def home(lcd, keyboard):
    from settings_ui import SettingsScreens
    from update_session import UpdateSession
    display = Display(lcd)
    store = ProfileStore(CONFIG)
    settings = SettingsScreens(display,keyboard,keys_ready,text_character,store)
    update = UpdateSession()
    if store.read().get("check_updates",True):
        update.check(startup=True)
    startup_prompted=False
    choice = 0
    try:
        while True:
            if update.state=="available" and not startup_prompted:
                startup_prompted=True
                review=settings.select("Update available",["Later","View update"],"ICOMzero "+update.updater.release[0]+" is ready")
                if review==1:settings.update(update)
            active = store.active()
            display.present(home_frame(display,choice,active["name"] if active["connection"]["Host"] else "",update.state=="checking"))
            for key, pressed in keys_ready(keyboard):
                if pressed != 1:
                    continue
                if key == 1:
                    return
                if key in (44,105,103):
                    choice = (choice-1)%3
                elif key in (46,106,108,15):
                    choice = (choice+1)%3
                elif key==31:
                    settings.general(update)
                    startup_prompted=True
                elif key == 28:
                    if choice==2:
                        settings.general(update)
                        startup_prompted=True
                    else:
                        (ui if choice == 0 else ft8_ui)(lcd, keyboard)
    finally:
        update.cancel()

def ft8_frame(
    display,
    history,
    callsign,
    ready,
    status,
    progress,
    transmitting=False,
    armed=False,
    meters=None,
    power_set=10,
    fault=None,
    auto_active=False,
    auto_label="AUTO",
    dial_hz=None,
):
    image = Image.new("RGB", (WIDTH, HEIGHT), BG)
    draw = ImageDraw.Draw(image)
    meters = meters or {}
    rows = history.visible(11)
    body_key = (callsign, history.start, history.selected,
                tuple((m.key, m.snr) for m in rows),
                (ready, status) if not rows else None)
    cached = getattr(display, "_ft8_decode_body", None)
    if isinstance(cached, tuple) and cached[0] == body_key:
        image = cached[1].copy()
        draw = ImageDraw.Draw(image)
    else:
        for row, message in enumerate(rows):
            y = row * 13 + 1
            own = message.involves(callsign)
            alternate = (history.start + row) % 2
            background = (
                "#173e5a"
                if message.local_tx
                else ("#674719" if own else ("#174d36" if activation_cq(message) else (CARD if alternate else BG)))
            )
            draw.rectangle((0, y, 319, y + 12), fill=background)
            text = ("TX " if message.local_tx else "") + message.text
            draw.text(
                (9, y - 1),
                text,
                font=display.fonts["small"],
                fill=(
                    "#8bd6ff"
                    if message.local_tx
                    else ("#ffe1a1" if own else (GREEN if alternate else WHITE))
                ),
            )
            region = short_country(message_country(message))
            snr = "" if message.local_tx else f" {message.snr:+03d}"
            available = 309 - draw.textlength(text, font=display.fonts["small"]) - 17
            label = region
            while label and draw.textlength(label + snr, font=display.fonts["small"]) > available:
                label = label[:-1]
            if label != region and len(label) > 1:
                label = label[:-1] + "…"
            if draw.textlength(label + snr, font=display.fonts["small"]) <= available:
                draw.text((311, y - 1), label + snr, anchor="ra",
                          font=display.fonts["small"], fill="#81998d" if own or activation_cq(message) else "#748a91")
            if message.key == history.selected:
                draw.rectangle((0, y, 319, y + 12), outline=GREEN)
                draw.text((0, y - 1), "›", font=display.fonts["small"], fill=GREEN)
        if not rows:
            draw.text(
                (12, 51),
                "Waiting for CQ calls" if ready else status[:40],
                font=display.fonts["body"],
                fill=GREEN,
            )
            draw.text(
                (12, 78),
                "CQ calls and your contacts appear here",
                font=display.fonts["small"],
                fill=MUTED,
            )
        display._ft8_decode_body = (body_key, image.copy())
    draw.rectangle((12, 146, 307, 148), fill=CARD)
    draw.rectangle(
        (12, 146, 12 + int(progress * 295), 148),
        fill="#f06464" if transmitting else GREEN,
    )
    draw.rounded_rectangle((228, 151, 311, 169), 5, fill=CARD)
    draw.text((235, 152), "Tab - Menu", font=display.fonts["small"], fill=WHITE)
    if armed or transmitting:
        draw.ellipse((10, 157, 16, 163), fill="#f06464")
        draw.rounded_rectangle((23, 151, 49, 169), 5,
                               fill="#8a2424" if transmitting else CARD)
        draw.text((27, 152), "TX", font=display.fonts["small"],
                  fill=WHITE if transmitting else MUTED)
    now = time.monotonic()

    def fresh(name):
        value = meters.get(name)
        stamp = meters.get(name + "_at")
        return (
            value
            if value is not None and stamp is not None and now - stamp <= 1.2
            else None
        )

    swr = fresh("swr")
    watts = fresh("watts")
    if watts is not None:
        watts = (
            meters.get("watts_display")
            if meters.get("watts_display") is not None
            else watts
        )
    if armed or transmitting:
        draw.text((56, 152), f"SWR {swr:.1f}" if transmitting and swr is not None else "SWR —",
                  font=display.fonts["small"], fill=WHITE if transmitting else MUTED)
    from ft8 import BANDS
    band_name = next((name for name, hz in BANDS if hz == dial_hz), "")
    power = (f"{watts:.0f}W" if watts is not None else "—W") if transmitting else f"{power_set}W"
    label = " ".join(filter(None, (band_name, power)))
    draw.text((122 if armed or transmitting else 12, 152), label,
              font=display.fonts["small"], fill=WHITE if transmitting else MUTED)
    if fault:
        image = notice_popup(display, image, "TX stopped", str(fault), warning=True,
                             hint="Enter - Clear warning")
    return image


def notice_popup(display, image, title, message, warning=False, hint=None):
    """Centered, wrapped cards keep long warnings readable on the small LCD."""
    shade = Image.new("RGBA", image.size, (0, 0, 0, 95))
    image = Image.alpha_composite(image.convert("RGBA"), shade).convert("RGB")
    draw = ImageDraw.Draw(image)
    font = display.fonts["small"]
    lines, line = [], ""
    for word in str(message).split():
        candidate = (line + " " + word).strip()
        if line and draw.textlength(candidate, font=font) > 258:
            lines.append(line)
            line = word
        else:
            line = candidate
    if line:
        lines.append(line)
    lines = lines[:4]
    height = 43 + 15 * len(lines) + (19 if hint else 0)
    top = max(10, (HEIGHT-height)//2)
    edge = "#ff9292" if warning else GREEN
    fill = "#3d2028" if warning else "#17372f"
    draw.rounded_rectangle((17,top+4,307,top+height+4),12,fill="#071016")
    draw.rounded_rectangle((14,top,304,top+height),12,fill=fill,outline=edge,width=2)
    draw.rounded_rectangle((26,top+13,30,top+29),2,fill=edge)
    draw.text((40,top+10),title,font=display.fonts["body"],fill=edge)
    for i,text in enumerate(lines):
        draw.text((28,top+34+i*15),text,font=font,fill=WHITE)
    if hint:
        draw.text((28,top+height-20),hint,font=font,fill=edge)
    return image


