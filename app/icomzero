def keys_ready(keyboard, timeout=.05):
    if not select.select([keyboard], [], [], timeout)[0]:
        return []
    data = os.read(keyboard, EVENT.size)
    if not data:
        raise OSError("Cardputer keyboard disconnected")
    return [(key, value) for _, _, kind, key, value in EVENT.iter_unpack(data) if kind == 1]


