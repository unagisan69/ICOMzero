            label(18, 149, "Tab / Esc - Close help", "small", MUTED)
        if radio_menu is not None:
            draw.rounded_rectangle((10, 23, 310, 153), 8, fill=BG, outline=GREEN)
            label(22, 34, "Radio settings", color=GREEN)
            for index, text in enumerate(("Band", f"Tuning step: {step} Hz", "Mode: " + {0:"LSB",1:"USB",3:"CW",7:"CW-R"}.get((radio_state or {}).get("mode"),"USB"), "CW decoder: " + ("On" if cw_enabled else "Off"), "CW tone: " + (str(cw_tone) + " Hz" if cw_tone else "Auto"), "Back")):
                y = 55 + index * 16
                if radio_menu == index:
                    draw.rounded_rectangle((18, y-2, 302, y+18), 4, fill=CARD)
                label(27, y, text, "small", GREEN if radio_menu == index else WHITE)
        self.present(image)

    def present(self, image):
        pixels = np.asarray(image, dtype=np.uint16)
        packed = ((pixels[:, :, 0] >> 3) << 11
                  | (pixels[:, :, 1] >> 2) << 5
                  | pixels[:, :, 2] >> 3)
        frame = packed.astype("<u2").tobytes()
        if self.stride == WIDTH * 2:
            if os.pwrite(self.fd, frame, self.offset) != len(frame):
                raise OSError("Short LCD write")
        else:
            for y in range(HEIGHT):
                row = frame[y * WIDTH * 2:(y + 1) * WIDTH * 2]
                if os.pwrite(self.fd, row, self.offset + y * self.stride) != len(row):
                    raise OSError("Short LCD write")


def ui(lcd, keyboard):
    from settings_ui import SettingsScreens
    from cw import Decoder as CWDecoder, Scrollback
    display = Display(lcd)
    values = load()
    if not values[0]:
        SettingsScreens(display, keyboard, keys_ready, text_character, ProfileStore(CONFIG)).radios()
        values = load()
        if not values[0]:
            return
    rx = Receiver()
    cw_decoder = CWDecoder(rate=RATE)
    rx.audio_observer = cw_decoder.feed
    rx.audio_gap_observer = cw_decoder.discontinuity
    cw_history = Scrollback()
    cw_enabled = False
    cw_tone = None
    last_mode = None
    shift = set()
    fn = False
    held_tune = None
    held_scroll = None
    next_scroll = 0
    next_repeat = 0
    save_at = None
    band = None
    radio_menu = None
    help_open = False
    volume_until = 0
    redraw = None
    next_paint = 0
    initial = time.monotonic() + 2
    try:
        while True:
            now = time.monotonic()
            if save_at is not None and now >= save_at:
                save(values, rx.volume, rx.muted)
                save_at = None
            if band is not None or radio_menu is not None or help_open or not rx.busy():
                held_tune = None
            if band is not None or radio_menu is not None or help_open or not cw_enabled:
                held_scroll = None
            if held_scroll is not None and now >= next_scroll:
                cw_history.scroll(-1 if held_scroll in (33,103) else 1)
                next_scroll = now + .09
            if held_tune is not None and now >= next_repeat:
                rx.tune(steps=-1 if held_tune in (44, 105) else 1)
                next_repeat = now + 0.09
            mode = rx.radio_state.get("mode")
            if mode != last_mode:
                if mode in (3, 7):
                    cw_enabled = True
                last_mode = mode
            cw_active = rx.busy() and cw_enabled and not rx.radio_state.get("ptt") and rx.radio_state.get("tuner") != 2
            cw_decoder.configure(cw_active, (rx.session_revision, rx.frequency, mode), tone=cw_tone)
            cw_state = cw_decoder.snapshot() if cw_enabled else None
            if cw_state is not None:
                revision=cw_state.get("revision",(rx.session_revision,rx.frequency,mode,cw_enabled,cw_tone))
                cw_history.update(cw_state.get("text",""),revision,cw_state.get("offset",0))
                cw_state.update(cw_history.view())
            if cw_state is not None and not cw_active:
                cw_state["status"] = "Connect to decode" if not rx.busy() else "Paused during TX/tuning"
            bands = presets(rx.radio_state.get("profile", DEFAULT_PROFILE), cw=cw_enabled or mode in (3, 7))
            busy = rx.busy()
            if not busy:
                band = None
            scope = rx.scope if busy and rx.scope and now - rx.scope[0] < 2 else None
            state = (tuple(values), None, False, rx.status, 0 if rx.muted else rx.volume, busy,
                     rx.displayed_frequency() if busy else None, scope, band, now < volume_until,
                     rx.radio_state, help_open, radio_menu, rx.step, cw_state, cw_enabled, cw_tone)
            if now >= next_paint and (state != redraw or now < initial):
                display.render(*state)
                redraw = state
                next_paint = now + 1 / 30
            for key, pressed in keys_ready(keyboard, 0.01):
                if key in (KEY_FN, KEY_CARDPUTER_FN):
                    fn = bool(pressed)
                    continue
                if key in (42, 54):
                    (shift.add if pressed else shift.discard)(key)
                    continue
                if not pressed:
                    if key == held_scroll:
                        held_scroll = None
                    if held_tune is not None and key in (44, 46, 105, 106):
                        held_tune = None
                    continue
                if pressed == 2:
                    continue
                if key in (KEY_FN_S, KEY_FN_D, KEY_VOLUME_DOWN, KEY_VOLUME_UP) or (fn and key in (31, 32)):
                    increase = key in (32, KEY_FN_D, KEY_VOLUME_UP)
                    rx.volume = min(100, max(0, rx.volume + (5 if increase else -5)))
                    rx.muted = False
                    volume_until = time.monotonic() + 1.4
                    save_at = time.monotonic() + 0.3
                    continue
                if key == 113 or (fn and key == 30):
                    rx.muted = not rx.muted
                    volume_until = time.monotonic() + 1.4
                    save_at = time.monotonic() + 0.3
                    continue
                if radio_menu is not None:
                    if key in (1, 15, 31):
                        radio_menu = None
                    elif key in (33, 44, 103, 105, 45, 46, 108, 106):
                        radio_menu = (radio_menu + (-1 if key in (33,44,103,105) else 1)) % 6
                    elif key == 28:
                        if radio_menu == 0:
                            if busy and rx.frequency:
                                band = min(range(len(bands)), key=lambda i: abs(bands[i][1] - rx.frequency))
                                radio_menu = None
                            else:
                                rx.update("Connect to choose a band")
                        elif radio_menu == 1:
                            rx.step = STEPS[(STEPS.index(rx.step) + 1) % len(STEPS)]
                            store = ProfileStore(CONFIG)
                            store.update(store.active()["id"], step=rx.step)
                        elif radio_menu == 2:
                            modes = (0, 1, 3, 7)
                            mode = rx.radio_state.get("mode", 1)
                            wanted = modes[(modes.index(mode) + 1) % len(modes)] if mode in modes else 1
                            rx.command("mode", wanted)
                        elif radio_menu == 3:
                            cw_enabled = not cw_enabled
                        elif radio_menu == 4:
                            tones = [None] + list(range(200, 2801, 100))
                            picker = SettingsScreens(display, keyboard, keys_ready, text_character, ProfileStore(CONFIG))
                            selection = picker.select("CW audio tone", ["Auto"] + [f"{hz} Hz" for hz in tones[1:]], "Choose the CW signal to decode", tones.index(cw_tone))
                            if selection is not None:
                                cw_tone = tones[selection]
                        else:
                            radio_menu = None
                    continue
                if key == 31 and not fn:
                    radio_menu = 0
                    help_open = False
                    band = held_tune = None
                    continue
                if help_open:
                    if key in (1, 15):
                        help_open = False
                    continue
                if band is not None:
                    if key in (1, 48):
                        band = None
                    elif key in (44, 46, 105, 106, 103, 108, 15):
                        step = {44: -1, 105: -1, 103: -3, 108: 3}.get(key, 1)
                        band = (band + step) % len(bands)
                    elif key == 28:
                        rx.change_band(bands[band][1])
                        band = None
                elif cw_enabled and key in (33,45,103,108):
                    cw_history.scroll(-1 if key in (33,103) else 1)
                    held_scroll = key
                    next_scroll = time.monotonic() + .35
                elif key == 15:
                    help_open = True
                    held_tune = None
                elif key == 1:
                    return
                elif key in (44, 46, 105, 106):
                    rx.tune(steps=-1 if key in (44, 105) else 1)
                    held_tune = key
                    next_repeat = time.monotonic() + 0.35
                elif key == 17:
                    cw_enabled = not cw_enabled
                elif key == 50:
                    rx.command("mode", 1 if rx.radio_state.get("mode") == 0 else 0)
                elif key == 49:
                    rx.command("nr")
                elif key == 20:
                    rx.command("tuner")
                elif key == 48 and rx.frequency and busy:
                    band = min(range(len(bands)), key=lambda i: abs(bands[i][1] - rx.frequency))
                elif key == 28:
                    if busy:
                        rx.stop.set()
                    else:
                        try:
                            rx.start(connection(values))
                        except RadioError as error:
                            rx.update(str(error))
    finally:
        if save_at is not None:
            save(values, rx.volume, rx.muted)
        rx.stop.set()
        if rx.thread is not None:
            rx.thread.join(timeout=2)
        cw_decoder.close()

