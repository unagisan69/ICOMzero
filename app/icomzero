                rx.command("nr")
            time.sleep(0.25)

    def show_panel(name):
        nonlocal panel, choice, editing, held
        panel = name
        choice = 0
        editing = False
        held = None

    def test_logging():
        results = []
        current = dict(settings)
        for service in ("wavelog", "qrz"):
            if not current[service + "_enabled"]:
                continue
            try:
                result = test_service(service, current)
                if service == "wavelog":
                    settings["wavelog_station"] = result.split()[-1]
                    save_settings(settings)
                results.append(service.title() + " OK")
            except Exception as error:
                results.append(service.title() + ": " + type(error).__name__)
        logbook.status = " · ".join(results) or "Enable a logging service first"

    try:
        rx.start(connection(values))
        while True:
            now = time.monotonic()
            if getattr(station, "qso_revision", 0) != qso_revision:
                qso_revision = station.qso_revision
                saved_qso = station.saved_qso
                qso_until = now + 3.5
            if station.status != last_station_status:
                last_station_status = station.status
                if not station.active and station.status not in (
                    "Receive only",
                    "Transmit stopped",
                ):
                    notify(station.status)
            profile = rx.radio_state.get("profile", DEFAULT_PROFILE)
            bands = [
                (name, hz)
                for name, hz in BANDS
                if any(low <= hz <= high for _, low, high in profile["bands"])
            ]
            revision = getattr(rx, "session_revision", 0)
            if configured and revision != session_revision:
                stop_tx()
                decoder.activate(False, clear=True)
                ready = configured = False
                pending_autotune = False
                dial = None
                band = None
                band_required = False
                history = History()
            session_revision = revision
            if (
                rx.frequency is not None
                and "mode" in rx.radio_state
                and (not profile["nr"] or "nr" in rx.radio_state)
                and not configured and not band_required
            ):
                if previous is None:
                    previous = (rx.frequency, rx.radio_state["mode"], rx.radio_state.get("nr"))
                if any(hz == rx.frequency for _, hz in bands):
                    dial = rx.frequency
                    radio_adjusted = True
                    rx.command("ft8_receive") if profile.get("ft8_data_mode") else rx.command("mode", 1)
                    if rx.radio_state.get("nr"):
                        rx.command("nr")
                    configured = True
                    pending_autotune = first_entry
                    first_entry = False
                elif bands:
                    band_required = True
                    panel = None
                    band = min(range(len(bands)), key=lambda i: abs(bands[i][1]-rx.frequency))
            if (
                pending_autotune
                and rx.frequency == dial
                and rx.radio_state.get("mode") == 1
                and (not profile.get("ft8_data_mode") or (rx.radio_state.get("data_mode") == profile["ft8_data_mode"] and all(rx.radio_state.get(name) == 0 for name in profile.get("tx_controls", {}))))
                and not rx.radio_state.get("ptt")
                and not rx.radio_state.get("ptt_pending")
            ):
                station.action("tune", dial=dial)
                pending_autotune = False
            receiving = (
                configured
                and rx.busy()
                and rx.frequency == dial
                and rx.radio_state.get("mode") == 1
                and (not profile.get("ft8_data_mode") or (rx.radio_state.get("data_mode") == profile["ft8_data_mode"] and all(rx.radio_state.get(name) == 0 for name in profile.get("tx_controls", {}))))
                and not rx.radio_state.get("ptt", False)
            )
            # Do not reset the decoder at each TX/RX transition: audio gap recovery
            # discards partial periods automatically, preserving decoded history.
            if not ready and receiving:
                decoder.activate()
                ready = True
            if ready and not rx.busy():
                decoder.activate(False)
                ready = False
            messages, status, progress = decoder.snapshot()
            current_band = next((name for name, hz in bands if hz == dial), "")
            worked = logbook.worked_calls(current_band, settings) if settings.get("hide_worked") else ()
            history.update(messages, settings["callsign"], worked, getattr(station, "current_partner", ""))
            if (
                held is not None
                and now >= next_repeat
                and panel is None
                and band is None
            ):
                history.move(held)
                next_repeat = now + 0.12
            if now - last_frame >= 0.08:
                if band is not None:
                    image, draw = menu_frame(
                        display, "Select FT8 band", f"{bands[band][1]/1e6:.3f} MHz · " + ("USB-D" if profile.get("ft8_data_mode") else "USB")
                    )
                    for i, (label, hz) in enumerate(bands):
                        x, y = 12 + i % 3 * 102, 52 + i // 3 * 23
                        draw.rounded_rectangle(
                            (x, y, x + 94, y + 22),
                            4,
                            fill=CARD,
                            outline=GREEN if i == band else CARD,
                        )
                        draw.text(
                            (x + 8, y + 3),
                            label,
                            font=display.fonts["small"],
                            fill=WHITE,
                        )
                    draw.text((12, 151), "Z / C choose · Enter begin · Esc exit" if band_required else "Z / C choose · Enter · Esc back", font=display.fonts["small"], fill=MUTED)
                elif panel is not None:
                    title = {
                        "menu": "FT8 Menu",
                        "logging": "Logging",
                        "sync": "Sync Log",
                        "station": "Station settings",
                        "wavelog": "Wavelog",
                        "qrz": "QRZ",
                        "local": "Local contacts",
                        "help": "FT8 shortcuts",
                        "manual": "Record QSO",
                    }[panel]
                    subtitle = (
                        station.clock_status
                        if panel == "menu"
                        else (
                            logbook.status
                            if panel in ("logging", "local")
                            else "Enter edit · Esc back"
                        )
                    )
                    if panel == "menu" and dial is not None:
                        title = "FT8 Menu · " + next((name for name,hz in bands if hz == dial), "")
                    if panel == "menu" and history.current() is not None:
                        title = "Selected decode"
                        subtitle = message_country(history.current()) + " · " + history.current().text
                    if panel == "manual":
                        subtitle = "Review exchanged reports, then save"
                    if panel == "sync":
                        subtitle = logbook.history_status
                    image, draw = menu_frame(display, title, subtitle[:43])
                    if panel in ("menu", "logging"):
                        items = list(menu_items) if panel == "menu" else log_items
                        if panel == "menu" and history.current() is not None:
                            items[1] = "Reply / continue"
                        if panel == "menu" and getattr(station, "auto_active", False) and getattr(station, "automation_label", "AUTO") == "AUTO":
                            items[2] = "Stop Auto CQ" + (f" ({station.queued_count} queued)" if getattr(station, "queued_count", 0) else "")
                        if panel == "menu" and getattr(station, "auto_active", False) and getattr(station, "automation_label", "AUTO") == "POTA":
                            items[3] = "Stop POTA Hunt"
                    elif panel == "sync":
                        items = ["Sync with Wavelog", "Sync with QRZ", "Back"]
                    elif panel == "help":
                        items = [
                            "F / Fn+F: previous decode",
                            "X / Fn+X: next decode",
                            "Enter: answer selected CQ",
                            "Gold rows: your callsign",
                            "Auto Hz: follow selected signal",
                            "Esc / Stop Transmit: stop TX",
                        ]
                    elif panel == "local":
                        items = [
                            f"{time.strftime('%m/%d %H:%M',time.gmtime(q['end']))} {q['call']} {q['band']}"
                            for q in logbook.recent()
                        ] or ["No completed contacts"]
                    else:
                        items = []
                        for label, key in fields[panel]:
                            if key in ("save", "sync_log"):
                                items.append(label)
                                continue
                            value = (manual_form if panel == "manual" else settings)[
                                key
                            ]
                            if isinstance(value, bool):
                                value = "On" if value else "Off"
                            elif key.endswith("_key"):
                                value = "•" * min(16, len(str(value))) or "(not set)"
                            else:
                                value = str(value)[-23:] or "(not set)"
                            items.append(
                                label
                                + ": "
                                + value
                                + (
                                    "▏"
                                    if editing and fields[panel][choice][1] == key
                                    else ""
                                )
                            )
                    first = max(0, min(choice - 4, len(items) - 6))
                    for row, index in enumerate(
                        range(first, min(first + 6, len(items)))
                    ):
                        y = 52 + row * 16
                        if index == choice:
                            draw.rounded_rectangle(
                                (8, y, 312, y + 16), 3, fill=CARD, outline=GREEN
                            )
                        draw.text(
                            (14, y),
                            items[index][:45],
                            font=display.fonts["small"],
                            fill=GREEN if index == choice else WHITE,
                        )
                    bottom = (
                        station.status
                        if panel == "menu"
                        else (
                            " · ".join(logbook.summary())
                            if panel == "logging"
                            else "F / X select · Enter · Tab / Esc back"
                        )
                    )
                    draw.text(
                        (12, 152),
                        bottom[:43],
                        font=display.fonts["small"],
                        fill=MUTED,
                    )
                else:
                    transmitting = bool(
                        rx.radio_state.get("ptt", False)
                        or rx.radio_state.get("tuner") == 2
                    )
                    image = ft8_frame(
                        display,
                        history,
                        settings["callsign"],
                        ready,
                        rx.status,
                        (time.time() % 15) / 15 if transmitting else progress,
                        transmitting,
                        armed=station.active,
                        auto_active=getattr(station, "auto_active", False),
                        auto_label=getattr(station, "automation_label", "AUTO"),
                        dial_hz=dial,
                        meters=rx.radio_state,
                        power_set=int(settings["tx_power_w"]),
                        fault=rx.radio_state.get("tx_fault"),
                    )
                if now < toast_until and not rx.radio_state.get("tx_fault"):
                    warning = any(word in toast.lower() for word in ("failed", "error", "lost", "not confirmed", "timed out", "unavailable", "blocked"))
                    image = notice_popup(display, image, "Attention" if warning else "ICOMzero", toast, warning=warning)
                if saved_qso and now < qso_until and not rx.radio_state.get("tx_fault"):
                    image = qso_popup(display, image, saved_qso)
                display.present(image)
                last_frame = now
            for key, pressed in keys_ready(keyboard, 0.01):
                if key in (KEY_FN, KEY_CARDPUTER_FN):
                    fn = bool(pressed)
                    continue
                if key in (42, 54):
                    (shift.add if pressed else shift.discard)(key)
                    continue
                if not pressed:
                    if key in (33, 45, 103, 108, 482):
                        held = None
                    continue
                if key == 28 and pressed == 1 and rx.radio_state.get("tx_fault"):
                    station.action("clear_fault")
                    notify("Checking radio RX to clear warning")
                    continue
                if key == 28 and pressed == 1 and now < toast_until and any(word in toast.lower() for word in ("failed", "error", "lost", "not confirmed", "timed out", "unavailable", "blocked")):
                    toast_until = 0
                    continue
                if editing:
                    label, field = fields[panel][choice]
                    editing_values = manual_form if panel == "manual" else settings
                    if key == 1:
                        editing_values[field] = original
                        editing = False
                    elif key == 28 and pressed == 1:
                        try:
                            if panel == "station":
                                settings["callsign"] = settings["callsign"].upper()
                                settings["grid"] = settings["grid"].upper()
                                validate_station(
                                    {
                                        **settings,
                                        "callsign": settings["callsign"] or "K1ABC",
                                        "grid": settings["grid"] or "FN42",
                                    }
                                )
                            if (
                                panel == "wavelog"
                                and settings["wavelog_url"]
                                and not settings["wavelog_url"].startswith("https://")
                            ):
                                raise ValueError("API URL must use HTTPS")
                            if field == "tx_power_w":
                                maximum = profile.get("rated_power_w", 100)
                                minimum = 5 if profile["model"] == "TS-890S" else 1
                                if int(editing_values[field]) < minimum:
                                    raise ValueError(f"Radio minimum is {minimum} W")
                                if int(editing_values[field]) > maximum:
                                    raise ValueError(f"Radio maximum is {maximum} W")
                                rx.command("ft8_power", int(editing_values[field]))
                            if panel != "manual":
                                if str(settings["tx_hz"]).strip().lower() == "auto":
                                    settings["tx_hz"] = "Auto"
                                save_settings(settings)
                            editing = False
                        except ValueError as error:
                            notify(error)
                    elif key == 14:
                        editing_values[field] = editing_values[field][:-1]
                    elif (char := text_character(key, shift)) is not None:
                        if len(editing_values[field]) < 256:
                            editing_values[field] += char
                    continue
                direction = (
                    -1
                    if key in (33, 103, 44, 105, 482)
                    else (1 if key in (45, 108, 46, 106) else 0)
                )
                if band is not None:
                    if key == 1 and band_required:
                        return
                    if key in (1, 15):
                        if not band_required:
                            band = None
                    elif direction:
                        band = (band + direction) % len(bands)
                    elif key == 28 and pressed == 1:
                        stop_tx()
                        dial = bands[band][1]
                        band_required = False
                        configured = True
                        first_entry = False
                        radio_adjusted = True
                        decoder.activate(False, clear=True)
                        ready = False
                        history = History()
                        pending_autotune = True
                        rx.tune(dial)
                        rx.command("ft8_receive") if profile.get("ft8_data_mode") else rx.command("mode", 1)
                        if rx.radio_state.get("nr"):
                            rx.command("nr")
                        band = None
                    continue
                if not configured:
                    if key == 1 and pressed == 1:
                        return
                    continue
                if panel is not None:
                    if key in (1, 15):
                        if panel == "menu":
                            panel = None
                        elif panel == "logging":
                            show_panel("menu")
                        elif panel == "sync":
                            show_panel("station")
                        elif panel in ("wavelog", "qrz", "local"):
                            show_panel("logging")
                        else:
                            show_panel("menu")
                    elif direction:
                        count = (
                            len(menu_items)
                            if panel == "menu"
                            else (
                                len(log_items)
                                if panel == "logging"
                                else (
                                    max(1, len(logbook.recent()))
                                    if panel == "local"
                                    else 3 if panel == "sync" else 6 if panel == "help" else len(fields[panel])
                                )
                            )
                        )
                        choice = (choice + direction) % count
                    elif key == 28 and pressed == 1:
                        if panel == "menu":
                            action = menu_items[choice]
                            if action == "Bands":
                                stop_tx()
                                band = min(
                                    range(len(bands)),
                                    key=lambda i: abs(bands[i][1] - dial),
                                )
                                panel = None
                            elif action == "Call CQ":
                                selected = history.current()
                                if selected is not None:
                                    station.action("reply", selected, dial)
                                    history.follow_bottom()
                                    notify("Continuing selected contact")
                                else:
                                    station.action("cq", dial=dial)
                                    notify("Calling CQ on next transmit period")
                                panel = None
                            elif action == "Auto CQ":
                                if getattr(station, "auto_active", False) and getattr(station, "automation_label", "AUTO") == "AUTO":
                                    stop_tx()
                                    notify("Auto CQ stopped")
                                else:
                                    station.action("auto_cq", dial=dial)
                                    history.follow_bottom()
                                    notify("Auto CQ: 1 CQ, then up to 5 targets")
                                panel = None
                            elif action == "POTA Hunt":
                                if getattr(station, "auto_active", False) and getattr(station, "automation_label", "AUTO") == "POTA":
                                    stop_tx()
                                    notify("POTA Hunt stopped")
                                else:
                                    station.action("pota_hunt", dial=dial)
                                    history.follow_bottom()
                                    notify("POTA Hunt monitoring POTA / SOTA CQs")
                                panel = None
                            elif action == "Settings":
                                stop_tx()
                                show_panel("station")
                            elif action == "Stop Transmit":
                                stop_tx()
                                notify("Transmit stopped")
                                panel = None
                            elif action == "Logging":
                                show_panel("logging")
                            elif action == "Record QSO":
                                selected = history.current()
                                if selected is None:
                                    notify("Highlight a contact decode first")
                                else:
                                    try:
                                        stop_tx()
                                        manual_meta = contact_draft(
                                            settings,
                                            decoder.snapshot()[0],
                                            selected,
                                            dial,
                                        )
                                        manual_form = {
                                            k: (
                                                ""
                                                if manual_meta[k] is None
                                                else str(manual_meta[k])
                                            )
                                            for k in (
                                                "call",
                                                "grid",
                                                "sent",
                                                "received",
                                            )
                                        }
                                        show_panel("manual")
                                    except ValueError as error:
                                        notify(error)
                            elif action == "Tune antenna":
                                station.action("tune", dial=dial)
                                panel = None
                            elif action == "Help":
                                show_panel("help")
                            else:
                                panel = None
                        elif panel == "logging":
                            action = log_items[choice]
                            if action in ("Wavelog", "QRZ"):
                                show_panel(action.lower())
                            elif action == "Test connections":
                                logbook.status = "Checking connections"
                                threading.Thread(
                                    target=test_logging, daemon=True
                                ).start()
                            elif action == "Sync pending":
                                logbook.sync()
                            elif action == "Local log":
                                show_panel("local")
                            elif action == "Sync Log":
                                show_panel("sync")
                            else:
                                show_panel("menu")
                        elif panel == "sync":
                            if choice == 2:
                                show_panel("station")
                            else:
                                try:
                                    logbook.sync_history(("wavelog", "qrz")[choice], dict(settings))
                                except ValueError as error:
                                    notify(error)
                        elif panel in fields:
                            field = fields[panel][choice][1]
                            if panel == "manual":
                                if field == "save":
                                    try:
                                        qso = finalize_contact(
                                            {**manual_meta, **manual_form}
                                        )
                                        station.action("record_qso", qso, dial)
                                        history.follow_bottom()
                                        panel = None
                                        notify("Saving QSO…")
                                    except ValueError as error:
                                        notify(error)
                                else:
                                    original = manual_form[field]
                                    editing = True
                            elif field == "sync_log":
                                show_panel("sync")
                            elif isinstance(settings[field], bool):
                                settings[field] = not settings[field]
                                save_settings(settings)
                            elif field == "cq_period":
                                settings[field] = (
                                    "Odd" if settings[field] == "Even" else "Even"
                                )
                                save_settings(settings)
                            else:
                                original = settings[field]
                                editing = True
                    continue
                if key == 15 and pressed == 1:
                    show_panel("menu")
                elif direction:
                    if pressed == 2 and held is not None:
                        continue
                    history.move(direction)
                    if pressed == 1:
                        held = direction
                        next_repeat = now + 0.35
                elif key == 1 and pressed == 1:
                    return
                elif key == 28 and pressed == 1:
                    message = history.current()
                    if message is None:
                        notify("Select a decode with F / X")
                    else:
                        station.action("reply", message, dial)
                        history.follow_bottom()
                        held = None
                        notify("Answering " + message.text)
                # B is retained as a convenience, with all band changes cancelling TX.
                elif key == 48 and pressed == 1 and bands:
                    stop_tx()
                    band = min(range(len(bands)), key=lambda i: abs(bands[i][1] - dial))
    finally:
        station.close()
        rx.stop_tx()
        decoder.activate(False)
        # Give the transport's repeated PTT-off path time before restoring tuning.
        time.sleep(0.45)
        restore_radio()
        rx.stop.set()
        if rx.thread:
            rx.thread.join(timeout=3)
        decoder.close()
        logbook.close()

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--configure", nargs=2, metavar=("HOST", "USERNAME"))
    modes.add_argument("--test-audio", type=float, metavar="SECONDS")
    modes.add_argument("--check-display", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--port", default=None)
    parser.add_argument("--model", choices=RADIO_CHOICES, default=None)
    parser.add_argument("--audio-port", default=None)
    parser.add_argument("--admin", action="store_true")
    args = parser.parse_args()
    if args.configure:
        host, username = args.configure
        password = getpass.getpass("Radio password: ") if sys.stdin.isatty() else sys.stdin.readline().rstrip("\n")
        values = load()
        values[:4] = (host, args.port or ("60000" if args.model == "TS-890S" else "50001"), username, password)
        if args.model is not None:
            values[4] = args.model
        if args.audio_port is not None:
            values[5] = args.audio_port
        if args.admin:
            values[6] = "Admin"
        connection(values)
        save(values)
    elif args.test_audio is not None:
        if not 0 < args.test_audio <= 120:
            parser.error("--test-audio requires 0 < seconds <= 120")
        rx = Receiver(lambda status: print(status, flush=True))
        rx.start(connection(load()))
        rx.thread.join(timeout=args.test_audio)
        rx.stop.set()
        rx.thread.join(timeout=2)
        print(f"RX packets {rx.packets}, ALSA bytes queued {rx.written}, queue drops {rx.dropped}")
        return int(rx.busy() or not rx.written or rx.status != "Disconnected")
    else:
        def exit_on_signal(*_):
            raise KeyboardInterrupt

        signal.signal(signal.SIGTERM, exit_on_signal)
        with open("/dev/fb_lcd", "r+b", buffering=0) as lcd:
            if args.check_display:
                Display(lcd.fileno()).render(load(), None, False, "Disconnected", 60, False, None, None, None, False)
            else:
                with open("/dev/input/cardputer-zero-internal", "rb", buffering=0) as keyboard:
                    home(lcd.fileno(), keyboard.fileno())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except RestartApp:
        os.execv(sys.executable, [sys.executable, __file__])
    except (RadioError, OSError, ValueError) as error:
        sys.exit(str(error))
