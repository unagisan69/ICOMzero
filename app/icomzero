    qso_revision = 0
    qso_until = 0
    saved_qso = None
    manual_form = None
    manual_meta = None
    held = None
    next_repeat = 0
    menu_items = [
        "Bands",
        "Call CQ",
        "Auto CQ",
        "POTA Hunt",
        "Settings",
        "Stop Transmit",
        "Logging",
        "Record QSO",
        "Tune antenna",
        "Help",
        "Back",
    ]
    log_items = [
        "Wavelog",
