#!/usr/bin/python3
"""Cardputer Zero receiver and launcher UI."""

import argparse
from array import array
from contextlib import suppress
import fcntl
import getpass
import json
import os
from pathlib import Path
import select
import signal
import struct
import subprocess
import sys
import tempfile
import threading
import time

from PIL import Image, ImageDraw, ImageFont

from civ import MIN_HZ, MAX_HZ
from radio import MODEL, RATE, RadioError, encode, listen

FIELDS = ("Host", "Control port", "Username", "Password")
DEFAULTS = ("", "50001", "", "")
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "icomzero/radio.json"
SPEAKER = "pulse"
SPEAKER_SINK = "alsa_output.platform-sound.stereo-fallback"
EVENT = struct.Struct("@llHHi")
WIDTH, HEIGHT = 320, 170
BG, CARD, WHITE, MUTED, GREEN = "#101a21", "#1d2d36", "#f0f6f6", "#9bb2bb", "#70edbb"
TUNE_STEP = 1000
BANDS = (
    ("160m", 1_900_000), ("80m", 3_750_000), ("60m", 5_357_000),
    ("40m", 7_150_000), ("30m", 10_125_000), ("20m", 14_200_000),
    ("17m", 18_130_000), ("15m", 21_250_000), ("12m", 24_950_000),
    ("10m", 28_400_000), ("6m", 50_125_000),
)
WATERFALL_W, WATERFALL_H = 296, 70
KEY_CARDPUTER_FN = 389
KEY_FN, KEY_FN_D, KEY_FN_S = 0x1D0, 0x1E0, 0x1E3
KEY_VOLUME_DOWN, KEY_VOLUME_UP = 114, 115
KEYS = {
    **dict(enumerate("1234567890-=", 2)),
    **dict(enumerate("qwertyuiop[]", 16)),
    **dict(enumerate("asdfghjkl;'\x60", 30)),
    **dict(enumerate("zxcvbnm,./", 44)),
    57: " ", 43: "\\",
}
SHIFTED = dict(zip("1234567890-=;',./[]\x60\\", "!@#$%^&*()_+:\"<>?{}~|"))


def read_config():
    try:
        data = json.loads(CONFIG.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save(values, volume=None, muted=None):
    data = read_config()
    data.update(zip(FIELDS, values))
    if volume is not None:
        data["volume"] = volume
    if muted is not None:
        data["muted"] = muted
    CONFIG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=CONFIG.parent, delete=False) as temp:
        try:
            json.dump(data, temp)
            temp.flush()
            os.replace(temp.name, CONFIG)
        finally:
            Path(temp.name).unlink(missing_ok=True)


def load():
    data = read_config()
    return [str(data.get(key, default)) for key, default in zip(FIELDS, DEFAULTS)]


def connection(values):
    host, port, user, password = values
    if not host.strip():
        raise RadioError("Enter the radio address in Setup")
    if not port.isascii() or not port.isdecimal() or not 1 <= int(port) <= 65535:
        raise RadioError("Control port must be 1–65535")
    encode(user)
    encode(password)
    return host.strip(), int(port), user, password


class Receiver:
    def __init__(self, report=lambda _: None):
        self.status = "Disconnected"
        data = read_config()
        volume = data.get("volume", 60)
        self.volume = volume if type(volume) is int and 0 <= volume <= 100 else 60
        self.muted = data.get("muted") is True
        self.packets = self.written = self.dropped = 0
        self.stop = threading.Event()
        self.thread = None
        self.report = report
        self.frequency = None
        self.scope = None
        self.target = None
        self.target_deadline = 0
        self.tune_queue = None
        self.tune_lock = threading.Lock()
        self.commands = []
        self.radio_state = {}

    def update(self, status):
        if self.status != status:
            self.status = status
            self.report(status)

    def start(self, settings):
        self.packets = self.written = self.dropped = 0
        self.frequency = self.scope = None
        self.target = self.tune_queue = None
        self.commands.clear()
        self.radio_state.clear()
        self.stop.clear()
        self.update("Finding radio")
        self.thread = threading.Thread(target=self.run, args=(settings,), daemon=True)
        self.thread.start()

    def run(self, settings):
        player = None
        last_start = 0
        startup_deadline = time.monotonic() + 8

        def start_player():
            return subprocess.Popen(
                ["aplay", "-q", "-D", SPEAKER, "-t", "raw", "-f", "S16_LE",
                 "-c", "1", "-r", str(RATE), "--buffer-time=300000", "--period-time=30000"],
                stdin=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0,
                env={**os.environ, "PULSE_SINK": SPEAKER_SINK},
            )

        try:
            def play(pcm):
                nonlocal player, last_start, startup_deadline
                now = time.monotonic()
                if player is not None and player.poll() is not None:
                    player.stdin.close()
                    player = None
                if player is None:
                    if now >= startup_deadline:
                        raise RadioError("Cardputer audio output unavailable")
                    if now - last_start < 0.25:
                        return
                    self.update("Opening audio output")
                    player = start_player()
                    os.set_blocking(player.stdin.fileno(), False)
                    last_start = now
                fd = player.stdin.fileno()
                self.packets += 1
                volume = 0 if self.muted else self.volume
                if volume != 100:
                    samples = array("h", pcm)
                    if sys.byteorder != "little":
                        samples.byteswap()
                    samples = array("h", (sample * volume // 100 for sample in samples))
                    if sys.byteorder != "little":
                        samples.byteswap()
                    pcm = samples.tobytes()
                try:
                    self.written += os.write(fd, pcm)
                    if now - last_start >= 0.1:
                        startup_deadline = now + 8
                        self.update("Receiving audio")
                except BlockingIOError:
                    self.dropped += 1
                except BrokenPipeError:
                    player.stdin.close()
                    player.wait()
                    player = None

            listen(*settings, self.stop, self.update, play,
                   self.frequency_changed, self.scope_changed, self.take_tune,
                   self.take_commands, self.radio_state_changed)
            self.update("Disconnected")
        except (RadioError, OSError) as error:
            self.update(str(error) if isinstance(error, RadioError) else f"Connection error: {error.strerror}")
        finally:
            if player is not None:
                player.stdin.close()
                try:
                    player.wait(timeout=0.6)
                except subprocess.TimeoutExpired:
                    player.kill()
                    player.wait()

    def frequency_changed(self, hz):
        with self.tune_lock:
            self.frequency = hz
            if hz == self.target:
                self.target = None

    def scope_changed(self, start, end, bins):
        self.scope = time.monotonic(), start, end, bins

    def radio_state_changed(self, name, value):
        self.radio_state = {**self.radio_state, name: value}

    def command(self, action, value=None):
        if self.busy() and not self.stop.is_set():
            with self.tune_lock:
                self.commands.append((action, value))

    def take_commands(self):
        with self.tune_lock:
            commands, self.commands = self.commands, []
            return commands

    def change_band(self, hz):
        self.tune(hz)
        # HF voice convention uses LSB on 160/80/40 m and USB on other presets.
        self.command("mode", 0 if hz < 10_000_000 and hz != 5_357_000 else 1)

    def tune(self, hz=None, steps=0):
        with self.tune_lock:
            if self.frequency is None or not self.busy() or self.stop.is_set():
                return
            if hz is None:
                base = self.target if time.monotonic() < self.target_deadline else None
                hz = (base or self.frequency) + steps * TUNE_STEP
            self.tune_queue = self.target = max(MIN_HZ, min(MAX_HZ, hz))
            self.target_deadline = time.monotonic() + 0.75

    def take_tune(self):
        with self.tune_lock:
            target, self.tune_queue = self.tune_queue, None
            return target

    def busy(self):
        return self.thread is not None and self.thread.is_alive()


class Display:
    def __init__(self, fd):
        self.fd = fd
        mode, fixed = bytearray(160), bytearray(80)
        fcntl.ioctl(fd, 0x4600, mode)
        fcntl.ioctl(fd, 0x4602, fixed)
        w, h, _, _, x, y, depth = struct.unpack_from("=7I", mode)
        colors = tuple(struct.unpack_from("=2I", mode, i) for i in (32, 44, 56))
        self.stride = struct.unpack_from("=I", fixed, 48)[0]
        if (w, h, depth, colors) != (WIDTH, HEIGHT, 16, ((11, 5), (5, 6), (0, 5))):
            raise OSError("Expected the stock 320×170 RGB565 LCD")
        if self.stride < (x + WIDTH) * 2:
            raise OSError("Invalid LCD stride")
        self.offset = y * self.stride + x * 2
        font = "/usr/share/fonts/truetype/dejavu/DejaVuSans"
        self.history = Image.new("RGB", (WATERFALL_W, WATERFALL_H), "#080f20")
        self.sweep = None
        self.edges = None
        self.levels = None
        self.palette = []
        stops = ((5, 10, 29), (20, 40, 119), (14, 118, 168),
                 (69, 209, 148), (255, 191, 69), (255, 246, 207))
        for value in range(256):
            position = (min(value, 160) / 160) ** 0.65 * (len(stops) - 1)
            index = min(int(position), len(stops) - 2)
            fraction = position - index
            self.palette.extend(round(low + (high - low) * fraction)
                                for low, high in zip(stops[index], stops[index + 1]))
        self.fonts = {
            "title": ImageFont.truetype(font + "-Bold.ttf", 22),
            "body": ImageFont.truetype(font + ".ttf", 14),
            "small": ImageFont.truetype(font + ".ttf", 12),
        }

    def update_waterfall(self, scope):
        if self.sweep is not None and scope is None:
            self.history.paste("#080f20", (0, 0, WATERFALL_W, WATERFALL_H))
            self.sweep = self.edges = self.levels = None
        if scope is None or scope[0] == self.sweep:
            return
        self.sweep, start, end, bins = scope
        span = end - start
        offset = 0
        if self.edges:
            old_start, old_end = self.edges
            offset = round((old_start - start) * WATERFALL_W / span)
            if old_end - old_start != span:
                offset = WATERFALL_W
        previous = self.history.crop((0, 0, WATERFALL_W, WATERFALL_H - 1))
        if offset:
            self.history.paste("#080f20", (0, 0, WATERFALL_W, WATERFALL_H))
        if abs(offset) < WATERFALL_W:
            self.history.paste(previous, (offset, 1))
        self.edges = start, end
        self.levels = [max(bins[x * len(bins) // WATERFALL_W:
                                (x + 1) * len(bins) // WATERFALL_W])
                       for x in range(WATERFALL_W)]
        row = Image.frombytes("P", (WATERFALL_W, 1), bytes(self.levels))
        row.putpalette(self.palette)
        self.history.paste(row.convert("RGB"), (0, 0))

    def render(self, values, selected, editing, status, volume, busy, frequency,
               scope, band, volume_visible, radio_state=None):
        image = Image.new("RGB", (WIDTH, HEIGHT), BG)
        draw = ImageDraw.Draw(image)

        def label(x, y, text, style="body", color=WHITE):
            font = self.fonts[style]
            while text and draw.textlength(text, font=font) > WIDTH - x - 12:
                text = text[:-1]
            draw.text((x, y), text, font=font, fill=color)

        self.update_waterfall(scope)
        if selected is not None:
            label(12, 7, "Setup", "title")
            label(206, 14, MODEL, "small", MUTED)
            for index, name in enumerate(FIELDS):
                y = 37 + 24 * index
                active = selected == index
                value = "•" * len(values[index]) if name == "Password" else values[index]
                value = value[-19:]
                if active:
                    draw.rounded_rectangle((8, y, 312, y + 22), radius=4, fill=CARD)
                label(13, y + 2, name, "small", GREEN if active else MUTED)
                label(105, y + 2, (value or "—") + ("▏" if active and editing else ""), "small")
            label(12, 147, "Enter save  ·  Esc cancel" if editing else
                  "↑↓ / Tab field   ·   Enter edit   ·   Esc done", "small", MUTED)
        elif band is not None:
            label(12, 7, "Select band", "title")
            for index, (name, hz) in enumerate(BANDS):
                x, y = 12 + index % 3 * 100, 37 + index // 3 * 27
                color = GREEN if index == band else WHITE
                draw.rounded_rectangle((x, y, x + 94, y + 23), 4, fill=CARD,
                                       outline=GREEN if index == band else CARD)
                label(x + 7, y + 4, f"{name}   {hz / 1e6:g}", "small", color)
            label(12, 151, "Z / C select   ·   Enter tune   ·   Esc back", "small", MUTED)
        else:
            label(12, 4, f"{frequency / 1e6:.6f}" if frequency else "ICOMzero", "title")
            if frequency:
                mode = {0: "LSB", 1: "USB", 2: "AM", 3: "CW", 4: "RTTY", 5: "FM",
                        7: "CW-R", 8: "RTTY-R"}.get((radio_state or {}).get("mode"), "MHz")
                if (radio_state or {}).get("nr"):
                    mode += " NR"
                if (radio_state or {}).get("tuner") == 2:
                    mode = "TUNING"
                label(160, 12, mode, "small", MUTED)
            badge = "RX" if status == "Receiving audio" else ("LINK" if busy else "OFF")
            label(279, 12, badge, "small", GREEN if badge == "RX" else MUTED)

            draw.rectangle((12, 35, 307, 67), fill="#111f2d")
            for x in (12, 86, 160, 234, 307):
                draw.line((x, 35, x, 67), fill="#26374a")
            for y in (45, 56, 67):
                draw.line((12, y, 307, y), fill="#26374a")
            image.paste(self.history, (12, 68))
            if self.edges and self.levels:
                start, end = self.edges
                draw.line([(12 + x, 67 - min(level, 160) * 31 // 160)
                           for x, level in enumerate(self.levels)], fill=GREEN)
                if frequency and start <= frequency <= end:
                    x = 12 + round((frequency - start) * (WATERFALL_W - 1) / (end - start))
                    draw.line((x, 35, x, 137), fill="#ffcc71")
                label(12, 138, f"{start / 1e6:.3f}", "small", MUTED)
                label(253, 138, f"{end / 1e6:.3f}", "small", MUTED)
            else:
                wait = "Waiting for scope data" if status == "Receiving audio" else status
                label(22, 91, wait, color=MUTED)
            label(12, 155, "Z/C tune · B bands · Ent - ■" if busy else
                  "Ent - ▶ · S setup · Esc exit", "small", MUTED)
        if volume_visible:
            draw.rounded_rectangle((207, 39, 304, 65), radius=6, fill=BG, outline=GREEN)
            label(215, 44, f"Volume {volume}%", "small", GREEN)
        frame = struct.pack(f"<{WIDTH * HEIGHT}H", *(
            (r >> 3) << 11 | (g >> 2) << 5 | b >> 3 for r, g, b in image.getdata()
        ))
        if self.stride == WIDTH * 2:
            if os.pwrite(self.fd, frame, self.offset) != len(frame):
                raise OSError("Short LCD write")
        else:
            for y in range(HEIGHT):
                row = frame[y * WIDTH * 2:(y + 1) * WIDTH * 2]
                if os.pwrite(self.fd, row, self.offset + y * self.stride) != len(row):
                    raise OSError("Short LCD write")


def ui(lcd, keyboard):
    display = Display(lcd)
    values = load()
    rx = Receiver()
    selected = None if values[0] else 0
    editing = False
    original = ""
    shift = set()
    fn = False
    held_tune = None
    next_repeat = 0
    save_at = None
    band = None
    volume_until = 0
    redraw = None
    next_paint = 0
    initial = time.monotonic() + 2
    try:
        while True:
            now = time.monotonic()
            if save_at is not None and now >= save_at:
                save(values, rx.volume, rx.muted)
                save_at = None
            if selected is not None or band is not None or not rx.busy():
                held_tune = None
            if held_tune is not None and now >= next_repeat:
                rx.tune(steps=-1 if held_tune in (44, 105) else 1)
                next_repeat = now + 0.09
            busy = rx.busy()
            if not busy:
                band = None
            scope = rx.scope if busy and rx.scope and now - rx.scope[0] < 2 else None
            state = (tuple(values), selected, editing, rx.status, 0 if rx.muted else rx.volume, busy,
                     rx.frequency if busy else None, scope, band, now < volume_until, rx.radio_state)
            if now >= next_paint and (state != redraw or now < initial):
                display.render(*state)
                redraw = state
                next_paint = now + 0.08
            if not select.select([keyboard], [], [], 0.05)[0]:
                continue
            events = os.read(keyboard, EVENT.size * 32)
            if not events:
                raise OSError("Cardputer keyboard disconnected")
            for _, _, kind, key, pressed in EVENT.iter_unpack(events):
                if kind != 1:
                    continue
                if key in (KEY_FN, KEY_CARDPUTER_FN):
                    fn = bool(pressed)
                    continue
                if key in (42, 54):
                    (shift.add if pressed else shift.discard)(key)
                    continue
                if not pressed:
                    if held_tune is not None and key in (44, 46, 105, 106):
                        held_tune = None
                    continue
                if pressed == 2:
                    continue
                if key in (KEY_FN_S, KEY_FN_D, KEY_VOLUME_DOWN, KEY_VOLUME_UP) or (fn and key in (31, 32)):
                    increase = key in (32, KEY_FN_D, KEY_VOLUME_UP)
                    rx.volume = min(100, max(0, rx.volume + (5 if increase else -5)))
                    rx.muted = False
                    volume_until = time.monotonic() + 1.4
                    save_at = time.monotonic() + 0.3
                    continue
                if key == 113 or (fn and key == 30):
                    rx.muted = not rx.muted
                    volume_until = time.monotonic() + 1.4
                    save_at = time.monotonic() + 0.3
                    continue
                if editing:
                    if key == 1:
                        values[selected], editing = original, False
                    elif key == 28 and pressed == 1:
                        try:
                            save(values)
                            editing = False
                        except OSError:
                            rx.update("Could not save settings")
                            selected, editing = None, False
                    elif key == 14:
                        values[selected] = values[selected][:-1]
                    elif key in KEYS:
                        char = KEYS[key]
                        if shift:
                            char = SHIFTED.get(char, char.upper())
                        limit = (253, 5, 16, 16)[selected]
                        if len(values[selected]) < limit and (selected != 1 or char.isdecimal()):
                            values[selected] += char
                elif selected is not None:
                    if key == 1:
                        selected = None
                    elif key in (15, 103, 108):
                        selected = (selected + (-1 if key == 103 else 1)) % len(FIELDS)
                    elif key == 28 and pressed == 1:
                        original, editing = values[selected], True
                elif band is not None:
                    if key in (1, 48):
                        band = None
                    elif key in (44, 46, 105, 106, 103, 108, 15):
                        step = {44: -1, 105: -1, 103: -3, 108: 3}.get(key, 1)
                        band = (band + step) % len(BANDS)
                    elif key == 28 and pressed == 1:
                        rx.change_band(BANDS[band][1])
                        band = None
                elif key == 1:
                    return
                elif key == 31 and not rx.busy():
                    selected = 0
                elif key in (44, 46, 105, 106):
                    rx.tune(steps=-1 if key in (44, 105) else 1)
                    held_tune = key
                    next_repeat = time.monotonic() + 0.35
                elif key == 49 and pressed == 1:
                    rx.command("nr")
                elif key == 20 and pressed == 1:
                    rx.command("tuner")
                elif key == 48 and rx.frequency and rx.busy() and pressed == 1:
                    band = min(range(len(BANDS)), key=lambda i: abs(BANDS[i][1] - rx.frequency))
                elif key == 28 and pressed == 1:
                    if rx.busy():
                        rx.stop.set()
                    else:
                        try:
                            rx.start(connection(values))
                        except RadioError as error:
                            rx.update(str(error))
    finally:
        if save_at is not None:
            save(values, rx.volume, rx.muted)
        rx.stop.set()
        if rx.thread is not None:
            rx.thread.join(timeout=2)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--configure", nargs=2, metavar=("HOST", "USERNAME"))
    modes.add_argument("--test-audio", type=float, metavar="SECONDS")
    modes.add_argument("--check-display", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--port", default="50001")
    args = parser.parse_args()
    if args.configure:
        host, username = args.configure
        password = getpass.getpass("Radio password: ") if sys.stdin.isatty() else sys.stdin.readline().rstrip("\n")
        values = (host, args.port, username, password)
        connection(values)
        save(values)
    elif args.test_audio is not None:
        if not 0 < args.test_audio <= 120:
            parser.error("--test-audio requires 0 < seconds <= 120")
        rx = Receiver(lambda status: print(status, flush=True))
        rx.start(connection(load()))
        rx.thread.join(timeout=args.test_audio)
        rx.stop.set()
        rx.thread.join(timeout=2)
        print(f"RX packets {rx.packets}, ALSA bytes queued {rx.written}, queue drops {rx.dropped}")
        return int(rx.busy() or not rx.written or rx.status != "Disconnected")
    else:
        def exit_on_signal(*_):
            raise KeyboardInterrupt

        signal.signal(signal.SIGTERM, exit_on_signal)
        with open("/dev/fb_lcd", "r+b", buffering=0) as lcd:
            if args.check_display:
                Display(lcd.fileno()).render(load(), None, False, "Disconnected", 60, False, None, None, None, False)
            else:
                with open("/dev/input/cardputer-zero-internal", "rb", buffering=0) as keyboard:
                    ui(lcd.fileno(), keyboard.fileno())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except (RadioError, OSError) as error:
        sys.exit(str(error))
